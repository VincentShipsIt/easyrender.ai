{
  "name": "easyrender",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:push": "bun run --cwd packages/db db:push",
    "db:generate": "bun run --cwd packages/db generate",
    "preflight": "bun scripts/preflight.ts",
    "check:ui-guards": "bun scripts/check-ui-guards.ts",
    "check:secrets": "bun scripts/check-secrets.ts",
    "evals:sync": "bun scripts/sync-evals.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  }
}
