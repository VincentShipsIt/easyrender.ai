# Postgres (Neon or Vercel Postgres in production)
DATABASE_URL=postgresql://localhost:5432/easyrender

# Replicate: runs the sheet (nano-banana-2-lite for the draft, nano-banana-2 for the final sheet) and the 3D build (TRELLIS)
REPLICATE_API_TOKEN=

# Private easyrenderai/harness repo (sheet prompt, model settings, guardrail limits). Read-only
# fine-grained token with Contents access to that repo only. Optional: without it the app uses the
# defaults bundled in packages/harness.
HARNESS_GITHUB_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please-ok
BETTER_AUTH_URL=http://localhost:3000
# Better Auth Dash (optional): from dash.better-auth.com; set it in Vercel, never in git.
BETTER_AUTH_API_KEY=
APP_URL=http://localhost:3000
# Google sign in (Google Cloud Console > Credentials > OAuth client, Web). Redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/google. When empty, the Google provider is not registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe. When STRIPE_SECRET_KEY is empty outside production, a fake checkout grants credits for testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pay as you go: a one-time $0.01 price, bought with quantity = credits.
STRIPE_PRICE_PAYG=
# Monthly plans, one recurring price each: Creator $19, Pro $49, Scale $149.
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# S3 storage behind CloudFront. When S3_BUCKET is empty, files are written to .data/ on local disk.
# On Vercel, AWS_ROLE_ARN is assumed through the deployment OIDC token; locally the default AWS profile is used.
# Objects are written under renders/, so ASSETS_CDN_URL=https://cdn.easyrender.ai serves /renders/....
S3_BUCKET=
ASSETS_CDN_URL=
AWS_REGION=
AWS_ROLE_ARN=

# Pipeline
SHEET_ENABLED=true
FREE_PREVIEWS_PER_DAY=2

# Sentry error monitoring. Empty DSN = off. Set all four in Vercel, never in git.
# The DSN is public (it ships to the browser); the auth token uploads source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional analytics (public project write key and GA web stream ID; set in Vercel).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server-only PostHog host override for local capture tests.
POSTHOG_HOST=
# Local production-build QA only; ignored in Vercel production (and any Vercel non-preview).
ANALYTICS_LOCAL_TEST=
# Shopify app (plugins/shopify): client id and secret from the Partner dashboard. Set in Vercel.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Internal analytics (server-only). Empty admin allowlist denies everyone.
ADMIN_EMAILS=
ANALYTICS_EXCLUDE_EMAILS=
ANALYTICS_TZ=Europe/Madrid
# Read-only query API credentials; separate from the public ingestion key/host above.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# Prefer a restricted read-only Stripe key; falls back to STRIPE_SECRET_KEY.
STRIPE_ANALYTICS_KEY=
