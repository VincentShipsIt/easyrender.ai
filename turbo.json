{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "REPLICATE_API_TOKEN",
        "HARNESS_GITHUB_TOKEN",
        "BETTER_AUTH_*",
        "STRIPE_*",
        "S3_BUCKET",
        "ASSETS_CDN_URL",
        "AWS_REGION",
        "AWS_ROLE_ARN",
        "NEXT_PUBLIC_*",
        "SENTRY_*",
        "SHOPIFY_*",
        "APP_URL",
        "SHEET_ENABLED",
        "FREE_PREVIEWS_PER_DAY",
        "ADMIN_EMAILS",
        "ANALYTICS_EXCLUDE_EMAILS",
        "ANALYTICS_TZ",
        "POSTHOG_PERSONAL_API_KEY",
        "POSTHOG_PROJECT_ID",
        "PRICING_AB_ENABLED",
        "PRICING_AB_E2E",
        "PRICING_E2E_URL",
        "POSTHOG_API_HOST",
        "STRIPE_ANALYTICS_KEY",
        "POSTHOG_HOST",
        "ANALYTICS_LOCAL_TEST"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
