generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth ─────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  credits       Int      @default(0)
  stripeCustomerId   String? @unique
  subscriptionId     String? @unique
  subscriptionStatus String?
  subscriptionPlan   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  renders   Render[]
  ledger    CreditLedger[]
  purchases Purchase[]
  apiKeys   ApiKey[]
  catalogItems CatalogItem[]
  shopifyShops ShopifyShop[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── App ─────────────────────────────────────────────────────

enum RenderStatus {
  drafting
  preview_ready
  rendering
  ready
  failed
}

model Render {
  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Visitors get a free preview before signing up; the anon cookie ties it to them.
  anonId            String?
  ipHash            String?
  prompt            String?
  // Display name for catalog items, usually the uploaded file name.
  name              String?
  status            RenderStatus @default(drafting)
  sourceKey         String
  sourceUrl         String?
  sheetKey          String?
  glbKey            String?
  // Material changes made by the owner, as a list of { index, baseColor?, roughness?, metalness? }
  // by glTF material. The stored GLB is never rewritten: the edits are applied when it is served.
  materialEdits     Json?
  // What the guardrails measured at each stage (photo, draft sheet, final sheet, model), for
  // comparing quality across renders. Never read to decide anything; see render-quality.ts.
  quality           Json?
  sheetPredictionId String?      @unique
  buildPredictionId String?      @unique
  // A paid build redraws the sheet with the final model before the 3D build; this is that prediction.
  finalSheetPredictionId String? @unique
  // Set by whichever call starts the 3D build, so webhook and polling cannot start it twice.
  buildClaimedAt    DateTime?
  costUsd           Float        @default(0)
  credits           Int          @default(0)
  error             String?
  // Finished renders show in the public gallery unless the owner hides them.
  isPublic          Boolean      @default(true)
  // A store embeds the model on its own product pages: anyone with the link can view it, but it
  // stays out of the public gallery unless isPublic is also true.
  isLinkShared      Boolean      @default(false)
  // Where the render was started: "web" (the app), "mcp" (an agent) or "api" (REST with a key).
  source            String       @default("web")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@index([ipHash, createdAt])
  @@index([isPublic, status, createdAt])
}

model CreditLedger {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String
  // One spend and one refund per render, one grant per purchase.
  idempotencyKey String @unique
  renderId   String?
  purchaseId String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String   @unique
  packId          String
  credits         Int
  amountCents     Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One product of a connected store (Shopify, WooCommerce, ...) that is turned into a 3D model.
// A plugin sends its products; the server walks each one from photo to finished model.
model CatalogItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  // The shop's domain or the site's host: one account can connect several stores.
  store      String
  // The product's id on the platform.
  externalId String
  title      String
  imageUrl   String
  note       String?
  renderId   String?
  // queued | drafting | building | ready | needs_credits | needs_info | failed
  state      String   @default("queued")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, platform, store, externalId])
  @@index([userId, platform, store, state])
  @@index([renderId])
}

// A Shopify store that installed the app. The merchant links it to an easyrender account, which pays
// for the models. The Admin API token is stored encrypted (see packages/core/src/shopify.ts).
model ShopifyShop {
  // The shop's permanent domain, e.g. my-store.myshopify.com.
  shop        String   @id
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessToken String
  scope       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
