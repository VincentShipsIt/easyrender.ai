generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth ─────────────────────────────────────────────

model User {
  // First-touch attribution. Nullable, additive, never overwritten.
  utm_source String?
  utm_medium String?
  utm_campaign String?
  utm_content String?
  utm_term String?
  referrer String?
  landing_path String?
  first_seen_at String?
  geo_country String?
  consent_region_at_create String?

  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  credits       Int      @default(0)
  stripeCustomerId   String? @unique
  subscriptionId     String? @unique
  subscriptionStatus String?
  subscriptionPlan   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  renders   Render[]
  ledger    CreditLedger[]
  purchases Purchase[]
  googleCheckouts GoogleCheckout[]
  apiKeys   ApiKey[]
  catalogItems CatalogItem[]
  shopifyShops ShopifyShop[]
  viewSets  ViewSet[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── App ─────────────────────────────────────────────────────

enum RenderStatus {
  drafting
  preview_ready
  rendering
  ready
  failed
}

model Render {
  // First-touch attribution. Nullable, additive, never overwritten.
  utm_source String?
  utm_medium String?
  utm_campaign String?
  utm_content String?
  utm_term String?
  referrer String?
  landing_path String?
  first_seen_at String?
  geo_country String?
  consent_region_at_create String?

  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Visitors get a free preview before signing up; the anon cookie ties it to them.
  anonId            String?
  ipHash            String?
  prompt            String?
  // Display name for catalog items, usually the uploaded file name.
  name              String?
  status            RenderStatus @default(drafting)
  sourceKey         String
  sourceUrl         String?
  sheetKey          String?
  glbKey            String?
  // Material changes made by the owner, as a list of { index, baseColor?, roughness?, metalness? }
  // by glTF material. The stored GLB is never rewritten: the edits are applied when it is served.
  materialEdits     Json?
  // What the guardrails measured at each stage (photo, draft sheet, final sheet, model), for
  // comparing quality across renders. Never read to decide anything; see render-quality.ts.
  quality           Json?
  // What the owner asked to fix in the angle sheet, and how many redraws they have paid for. The
  // note joins the prompt in every later sheet, including the final one of the paid build.
  sheetNote         String?
  sheetRedraws      Int          @default(0)
  sheetPredictionId String?      @unique
  buildPredictionId String?      @unique
  // A paid build redraws the sheet with the final model before the 3D build; this is that prediction.
  finalSheetPredictionId String? @unique
  // True when the sheet is already the final 2K sheet (it came from a product views set), so the
  // paid build skips the redraw and only charges for the 3D step.
  hasFinalSheet     Boolean      @default(false)
  // Set by whichever call starts the 3D build, so webhook and polling cannot start it twice.
  buildClaimedAt    DateTime?
  costUsd           Float        @default(0)
  credits           Int          @default(0)
  error             String?
  // Finished renders show in the public gallery unless the owner hides them.
  isPublic          Boolean      @default(true)
  // A store embeds the model on its own product pages: anyone with the link can view it, but it
  // stays out of the public gallery unless isPublic is also true.
  isLinkShared      Boolean      @default(false)
  // Where the render was started: "web" (the app), "mcp" (an agent) or "api" (REST with a key).
  source            String       @default("web")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@index([ipHash, createdAt])
  @@index([isPublic, status, createdAt])
}

// Product views: one photo in, nine packshots out on white, with no 3D build. A set is paid for
// when it is created; its views can be polished one by one afterwards.
enum ViewSetStatus {
  drafting
  processing
  ready
  failed
}

enum ProductViewStatus {
  drawing
  upscaling
  ready
}

model ViewSet {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String?
  prompt            String?
  status            ViewSetStatus @default(drafting)
  sourceKey         String
  sourceUrl         String?
  // The 3x3 sheet the views were cut from, and how many sheets were drawn (one automatic retry).
  sheetKey          String?
  sheetPredictionId String?       @unique
  sheetAttempts     Int           @default(1)
  // What the guardrails measured on the sheet and on each view, for comparing quality over time.
  quality           Json?
  credits           Int           @default(0)
  costUsd           Float         @default(0)
  error             String?
  // The 3D render made from these views, once the owner chose to build one.
  renderId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  views             ProductView[]

  @@index([userId, createdAt])
}

model ProductView {
  id           String            @id @default(cuid())
  setId        String
  set          ViewSet           @relation(fields: [setId], references: [id], onDelete: Cascade)
  // One of the nine sheet positions: front, front_right, ..., top.
  view         String
  status       ProductViewStatus @default(drawing)
  // The finished packshot (white background, fixed canvas). Empty until the first one is made.
  key          String?
  // The drawn view before it was upscaled and finished.
  rawKey       String?
  predictionId String?           @unique
  // Redraws tried for this stage; the automatic ones stop at the harness limit.
  attempts     Int               @default(0)
  // What the owner asked to fix, and how many polishes they have paid for.
  note         String?
  polishes     Int               @default(0)
  // True while the current stage is a paid polish, so a failed one is refunded and reverted.
  isPolishing  Boolean           @default(false)
  // The checks that ran on the current picture: the problems found, if any.
  qa           Json?
  version      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([setId, view])
}

model CreditLedger {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String
  // One spend and one refund per render, one grant per purchase.
  idempotencyKey String @unique
  renderId   String?
  purchaseId String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String   @unique
  packId          String
  credits         Int
  amountCents     Int
  currency        String   @default("usd")
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  googleDelivery GooglePurchaseDelivery?
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One product of a connected store (Shopify, WooCommerce, ...) that is turned into a 3D model.
// A plugin sends its products; the server walks each one from photo to finished model.
model CatalogItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  // The shop's domain or the site's host: one account can connect several stores.
  store      String
  // The product's id on the platform.
  externalId String
  title      String
  imageUrl   String
  note       String?
  renderId   String?
  // queued | drafting | building | ready | needs_credits | needs_info | failed
  state      String   @default("queued")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, platform, store, externalId])
  @@index([userId, platform, store, state])
  @@index([renderId])
}

// A Shopify store that installed the app. The merchant links it to an easyrender account, which pays
// for the models. The Admin API token is stored encrypted (see packages/core/src/shopify.ts).
model ShopifyShop {
  // The shop's permanent domain, e.g. my-store.myshopify.com.
  shop        String   @id
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessToken String
  scope       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Consent-scoped linkage for a single checkout; never sent to Stripe as metadata.
model GoogleCheckout {
  id          String @id
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  sessionId   String
  invoiceId   String? @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  delivery    GooglePurchaseDelivery?
  @@index([userId])
}

// Durable purchase outbox. Its stable transaction ID also deduplicates uncertain network retries.
model GooglePurchaseDelivery {
  purchaseId  String @id
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  checkoutId  String @unique
  checkout    GoogleCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  attempts    Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil  DateTime?
  deliveredAt DateTime?
  lastError   String?
  @@index([deliveredAt, nextAttemptAt])
}
