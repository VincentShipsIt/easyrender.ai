{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run vercel-build",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ] && git diff --quiet HEAD^ HEAD -- ':/apps/web' ':/packages' ':/package.json' ':/bun.lock' ':/turbo.json' ':/vercel.json'",
  "crons": [
    {
      "path": "/api/cron/analytics",
      "schedule": "0 4 * * *"
    }
  ]
}
